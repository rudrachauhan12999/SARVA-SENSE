# Groq (LLM generation + grounding verification)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (OCR + HMI screenshot vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Local embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval tuning
RAG_TOP_K=6
RAG_MIN_RELEVANCE=42
RAG_MIN_CHUNK_WORDS=20

# OCR fallback for scanned manual pages during ingestion (uses Gemini Vision)
RAG_OCR_FALLBACK=true
RAG_OCR_MIN_WORDS=8

# CORS - comma separated origins, or * for all (dev only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
